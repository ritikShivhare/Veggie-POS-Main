# Required for production. Keep service-role and provider keys server-side.
NODE_ENV=development
PORT=3000
APP_URL=
ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Render free services need HTTPS email (SMTP ports are blocked).
# EMAIL_FROM must use a domain verified with Resend, not onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMTP alternative on a host that permits SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Supabase Auth administrator: approved UID + app_metadata.role SUPER_ADMIN + MFA.
# These must refer to the same Supabase project. Service-role key stays backend-only.
SUPER_ADMIN_USER_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional lockout override. Use a long random secret (at least 16 characters).
MASTER_VERIFICATION_CODE=

# Optional providers. Restaurant Cash/manual UPI work without a SaaS payment gateway.
GEMINI_API_KEY=
GEMINI_MODEL=
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# HTTPS public origin for return URL; webhook configured separately in Cashfree
APP_URL=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
EMAIL_ALERT_ADDRESS=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
