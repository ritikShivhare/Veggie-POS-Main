# Required for production. Keep service-role and provider keys server-side.
NODE_ENV=development
PORT=3000
APP_URL=
ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Render free services need HTTPS email (SMTP ports are blocked).
# EMAIL_FROM must use a domain verified with Resend, not onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMTP alternative on a host that permits SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SaaS administrator identity. Password sign-in also requires email OTP.
SAAS_OWNER_EMAIL=
SAAS_OWNER_PASSWORD_HASH=
# Optional Google sign-in; an OAuth web client ID, never an API key.
GOOGLE_CLIENT_ID=
# Optional lockout override. Use a long random secret (at least 16 characters).
MASTER_VERIFICATION_CODE=

# Optional providers. Cash/manual UPI work without Stripe or AI credentials.
GEMINI_API_KEY=
GEMINI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
EMAIL_ALERT_ADDRESS=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
